[Desktop Entry]
Type=Application
Name=Aurora Studio
GenericName=Roblox Studio launcher
Comment=Launch Roblox Studio through Aurora
Exec=aurora_studio %u
Icon=space.bigrat.aurora-studio
# Wine exposes the Roblox Studio child as RobloxStudioBeta.exe. Matching that
# window lets KDE use Aurora's desktop icon for the real Studio window.
StartupWMClass=RobloxStudioBeta.exe
Categories=Development;
Terminal=false
MimeType=application/x-roblox-place;application/x-roblox-model;x-scheme-handler/roblox-studio;
Actions=Settings;

[Desktop Action Settings]
Name=Aurora Studio Settings
Exec=aurora_studio --settings
Icon=space.bigrat.aurora-studio

X-Aurora-Managed=true
